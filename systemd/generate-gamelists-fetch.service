[Unit]
Description=Fetch metadata and generate gamelists (oneshot)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=kiosk
Group=kiosk
ExecStart=/usr/bin/python3 /home/kiosk/tools/generate_gamelists.py --romdir /home/kiosk/roms --merge --fetch-art

[Install]
WantedBy=multi-user.target
